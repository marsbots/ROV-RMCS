# Copy to .env and fill in real values before exposing the server.
# JWT_SECRET is REQUIRED (server will not start without it). Use a long random string.
JWT_SECRET=

# User credentials (no built-in defaults).
DEMO_USER=
DEMO_PASSWORD=
ADMIN_USER=
ADMIN_PASSWORD=

VEHICLES_FILE=server/config/vehicles.json
AUDIT_FILE=data/audit.jsonl

COMMAND_TTL_MS=500
NEUTRAL_HZ=10
ESTOP_REPEAT_S=1
MAX_COMMAND_HZ=50

# CORS: comma-separated origins. Default is https://rmcs.marsbot.kr
CORS_ORIGINS=https://rmcs.marsbot.kr

# Optional public URLs advertised to pilots / agents
PUBLIC_WS_BASE=
PUBLIC_WHEP_BASE=
PUBLIC_RTSP_BASE=

# Device tokens are provided via token_env references in vehicles.json, e.g.
# ROV_TOKEN_ROV_01=<secret>
