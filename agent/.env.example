# Copy to .env on the vehicle (or pass as container env).
SERVER_URL=http://your-control-server:8080
VEHICLE_TOKEN=replace-with-provisioned-device-token

MAVLINK_ENDPOINT=udpin:0.0.0.0:14599
VEHICLE_SYSID=1
VEHICLE_COMPID=1
GCS_SYSID=255
GCS_COMPID=190

COMMAND_TTL_MS=500
NEUTRAL_HZ=10
ESTOP_HZ=20
ESTOP_DISARM=true

TELEMETRY_HZ=2
SURFACE_PRESSURE_HPA=1013.25
AGENT_HEALTH_PORT=8081

# Out-of-band video (optional)
VIDEO_WHEP_URL=
VIDEO_RTSP_URL=

RECONNECT_MIN_S=1
RECONNECT_MAX_S=20
